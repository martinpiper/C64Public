	; Setup zeropage
	ldx #DecompCodeSize
.czl1
	lda+2 DecompCodeStart-1,x
	sta+2 DecompCodeRealStart-1,x
	dex
	bne .czl1

.l1
	+MACROWaitForRaster $42
