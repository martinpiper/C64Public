;main test code
kBus24Bit_VideoLayer_HasOverscan=1
kBus24Bit_VideoLayer_ExpandedPalettes = 1
kBus24Bit_VideoLayer_ExpandedPaletteLayers = 1
kBus24Bit_SpritesMaxNum = 32

kHardwareTest_UsingSprites4 = 1
kBus24Bit_Sprites4_Controls2		= $b800
kBus24Bit_Sprites4_Registers2		= $b808

!source "stdlib/stdlib.a"
!source "stdlib/LongBranches.a"
!source "BombJack/stdlib/Bus24Bit_Macros.a"
!source "BombJack/stdlib/Bus20To32Bit1_Macros.a"
!source "BombJack/stdlib/Video_Macros.a"
!source "BombJack/stdlib/APU_Macros.a"
!source "asm/AfterBurner/Audio2_Macros.a"

!to "bin/main.prg", cbm
!sal
!sl "tmp/main.map"
!svl "tmp/main.lbl"
!pdb "tmp/main.pdb"
!cpu 6510
!ct pet

; Save space for zeroPageCode_realStart
zeroPage_Temp0	= $10
zeroPage_Temp1	= $11

; Define this to include graphics data
IncludeGraphicsData = 1

!zn
*=$200
	+MStopInitStack_X
	jmp start
	
!source "tmp/FingerPrint.a"

* = SCREENRAM
Initialise_NoPreserveStack = 1
Initialise_NoMACROWaitForTheLastScan = 1
Initialise_NoIRQServiceRoutine = 1
!source "stdlib/Initialise.a"
!source "BombJack/stdlib/Bus24Bit.a"
!source "BombJack/stdlib/Bus20To32Bit1.a"
!source "BombJack/stdlib/Video.a"
!source "BombJack/stdlib/HardwareTest.a"
!source "BombJack/stdlib/APU.a"

!zn
start
	sei
	lda #ProcessorPortAllRAMWithIO
	jsr InitialiseMachine
	jsr Bus20To32Bit1_Init
	jsr Bus24Bit_Init
	jsr Bus20To32Bit1_Init
	jsr APU_ResetDisableClear
	jsr Video_DisableDisplay
	jsr APU_ResetDisableClear

!ifdef IncludeGraphicsData {
	jsr HardwareTest_VideoPattern0

	; And the extra chars layer...
	+MBus24Bit_SetAddress_AXY $90 , kBus24Bit_CharScreenMap
	jsr HardwareTest_VideoPattern0_SendCharsMap

	+MBus24Bit_SetAddress_AXY $90 , kBus24Bit_CharColourMap
	jsr HardwareTest_VideoPattern0_SendCharsColourMap


	+MBus24Bit_SetAddress_AXY $30 , kBus24Bit_CharScreenPlanes_0
	jsr HardwareTest_VideoPattern0_SendCharsPlane0

	+MBus24Bit_SetAddress_AXY $30 , kBus24Bit_CharScreenPlanes_1
	jsr HardwareTest_VideoPattern0_SendCharsPlane1

	+MBus24Bit_SetAddress_AXY $30 , kBus24Bit_CharScreenPlanes_2
	jsr HardwareTest_VideoPattern0_SendCharsPlane2

	+MBus24Bit_SetAddress_AXY $30 , kBus24Bit_CharScreenPlanes_3
	jsr HardwareTest_VideoPattern0_SendCharsPlane3

	+MBus24Bit_SetAddress_A kBus24Bit_CharScreen_EBBS , $a800
	+MBus24Bit_Send8BitValue 0
	+MBus24Bit_SendLE16BitValue -48
	+MBus24Bit_SendLE16BitValue -12

;	+WaitForFire_A
}

	; Test APU and display hardware
!if 1 {
	+WaitForFire_A

	jsr SetupAPU
	jsr APU_ResetDisable
	jsr APU_Enable

;	jsr Video_InitDisplaySpritesScrollsBackground

	; No mode7 layer, since it blocks the background register
	jsr Video_SetAddressVideoPriorityRegister
	+MBus24Bit_VideoLayer_EmitPriority_NearToFar_A kBus24Bit_VideoLayer_Priority_Pixel0 , kBus24Bit_VideoLayer_Priority_Pixel1 , kBus24Bit_VideoLayer_Priority_Pixel1 , kBus24Bit_VideoLayer_Priority_Pixel1

	jsr Video_SetAddressVideoBackgroundColour
	+MBus24Bit_Send8BitValue 0
	jsr Video_SetAddressVideoControlRegisters
	+MBus24Bit_Send8BitValue kVideo_EnableDisplay_Use_BGColour | kVideo_EnableDisplay_Enable

	+WaitForFire_A

	; Check bus arbitration with the CPU and APU by updating the char scroll registers all the time
.us1
;	jsr Video_WaitVBlank
	jsr Video_SetAddressCharScrollRegisters
	+MBus24Bit_SendLE16BitValue -16
	+MBus24Bit_SendLE16BitValue -32
	+WaitForFireLoop_A .us1

	; Check bus arbitration with variable sprites4 writes
	+MBus24Bit_SetAddress_A kBus24Bit_Sprites4_EBBS , kBus24Bit_Sprites4_Controls
	+MBus24Bit_Send8BitValue 0
	+MBus24Bit_SetAddress_A kBus24Bit_Sprites4_EBBS , kBus24Bit_Sprites4_Controls
	jsr InitSprites4

.rspt1
	jsr Video_WaitVBlank
	jsr Video_StartRasterTimers
	jsr Bus20To32Bit1_Init

	+MByteValueToAddress_A 4 , zeroPage_Temp0
	+MByteValueToAddress_A 4 , zeroPage_Temp1

	; A very large sprite formation
	+MBus24Bit_SetAddress_A kBus24Bit_Sprites4_EBBS , kBus24Bit_Sprites4_Controls
	+MBus24Bit_Send8BitValue %10
	+MBus24Bit_SetAddress_A kBus24Bit_Sprites4_EBBS , kBus24Bit_Sprites4_Registers
	ldx #128
.ssl1
	; Palette
	+MBus24Bit_Send8BitValue 0
	; Y pos and size
	+MBus24Bit_Send8BitValueFromAddress zeroPage_Temp1
	+MBus24Bit_Send8BitValue 16
	; X pos and size
	+MBus24Bit_Send8BitValueFromAddress zeroPage_Temp0
	+MBus24Bit_Send8BitValue 16
	; Address
	jsr Video_clearThreeBytes
	; Scales
	+MBus24Bit_Send8BitValue $10
	+MBus24Bit_Send8BitValue $10
	; Stride
	+MBus24Bit_Send8BitValue 4

	+MAddU8ToAddr8 19 , zeroPage_Temp0
	+MAddU8ToAddr8 1 , zeroPage_Temp1

	dex
	bne .ssl1

	; End of list
	jsr Video_clearThreeBytes


	+MBus24Bit_SetAddress_A kBus24Bit_Sprites4_EBBS , kBus24Bit_Sprites4_Controls
	; Flag ready and enable logic
	+MBus24Bit_Send8BitValue %11

	+WaitForFireLoopL_A .rspt1

	; Just displays chars
	jsr Video_SetAddressVideoPriorityRegister
	+MBus24Bit_VideoLayer_EmitPriority_NearToFar_A kBus24Bit_VideoLayer_Priority_Pixel1 , kBus24Bit_VideoLayer_Priority_Pixel1 , kBus24Bit_VideoLayer_Priority_Pixel1 , kBus24Bit_VideoLayer_Priority_Pixel1

	; CPU write to APU data and scroll registers test
.cwad1
	+MAPU_SetDataUpdateBus APUData_RasterBarStart + (151 * APUData_RasterBar_size) + APUData_RasterBar_palette
	+MBus24Bit_SendPaletteRGB 16 , 16 , 16
	+MAPU_SetDataUpdateBus APUData_RasterBarStart + (154 * APUData_RasterBar_size) + APUData_RasterBar_palette
	+MBus24Bit_SendPaletteRGB 32 , 32 , 32
	+MAPU_SetDataUpdateBus APUData_RasterBarStart + (157 * APUData_RasterBar_size) + APUData_RasterBar_palette
	+MBus24Bit_SendPaletteRGB 64 , 64 , 64
	+MAPU_SetDataUpdateBus APUData_RasterBarStart + (160 * APUData_RasterBar_size) + APUData_RasterBar_palette
	+MBus24Bit_SendPaletteRGB 128 , 128 , 128
	jsr Video_SetAddressCharScrollRegisters
	+MBus24Bit_SendLE16BitValue -20
	+MBus24Bit_SendLE16BitValue -38
	+WaitForFireLoopL_A .cwad1


}



;	+WaitForFire_A

	jsr Bus24Bit_Init
	jsr Video_DisableDisplay
	jsr APU_ResetDisableClear

!if 0 {
	lda #kVideo_EnableDisplay_Enable
	jsr Video_EnableDisplay
	jsr Video_SetAddressVideoLayersEnable
	+MBus24Bit_Send8BitValue kBus24Bit_VideoLayer_LayersEnable_2
	jsr Video_SetAddressVideoControlRegisters
	+MBus24Bit_Send8BitValue kVideo_EnableDisplay_Use_BGColour | kVideo_EnableDisplay_Enable | kVideo_EnableDisplay_Use_RGBBackground
}

!if 0 {
	; DMA 2MB from external RAM to bitmap RGB RAM or Audio RAM
.otherClear3
	; DMA Copy
	jsr Bus24Bit_Init
	; BackgroundRGB bank address
